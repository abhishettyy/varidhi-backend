# Varidhi Marine Intelligence Platform - Environment Configuration

# LLM Provider: 'mock' (default for offline/tests), 'gemini', 'openai'
LLM_PROVIDER=gemini

# Model selection (defaults: gemini-1.5-flash for gemini, gpt-4o-mini for openai)
LLM_MODEL=gemini-1.5-flash

# API Credentials (leave empty when using mock provider)
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_API_KEY=

# Optional custom API endpoint base URL
LLM_API_BASE=

# Generation parameters
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=10.0
LLM_MAX_RETRIES=1

# P5 source: mock (default) or complete (data/processed/p5_data.json)
P5_SOURCE=mock
# P5_COMPLETE_DATA_PATH=E:\\SIH26\\data\\processed\\p5_data.json

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=
VARIDHI_API_URL=http://127.0.0.1:8105
